# Self-hosted runners (compose.yaml). Copy to .env, which git ignores, or set
# these as a Portainer stack's environment variables.

# A fine-grained personal access token with access to this repository only
# and "Administration: Read and write" (to register runners), with an
# expiry. Only the controller holds it: it issues each runner a single-use
# configuration, so jobs never see it.
ACCESS_TOKEN=

# The repository the runners serve.
REPO_URL=https://github.com/868-no/map

# Labels besides self-hosted, comma separated. The repository variable
# RUNNER_LABELS selects them: ["self-hosted","meshmap"].
RUNNER_LABELS=meshmap

# Runner names: <prefix>-<slot>-<time>. Give each host its own prefix: the
# controller removes idle offline runners of its prefix when it starts.
RUNNER_NAME_PREFIX=meshmap
