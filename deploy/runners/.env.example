# Self-hosted runners (compose.yaml). Copy to .env, which git ignores.

# A fine-grained personal access token with access to this repository only
# and "Administration: Read and write" (to register runners). The runners
# use it to fetch a registration token for each job; jobs never see it.
ACCESS_TOKEN=

# The repository the runners serve.
REPO_URL=https://github.com/868-no/map

# Extra labels (besides self-hosted, linux, x64/arm64), comma separated. The
# repository variable RUNNER_LABELS selects them: ["self-hosted","meshmap"].
RUNNER_LABELS=meshmap

# Runner names: <prefix>-1 … <prefix>-4. Give each host its own prefix.
RUNNER_NAME_PREFIX=meshmap
