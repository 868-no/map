    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/luxon": "3.7.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
