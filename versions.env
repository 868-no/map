# Toolchain and image versions: the single source for scripts/*.sh and CI.
# Plain KEY=value lines (no quotes, no ${...}), so shells, `docker --env-file`
# and $GITHUB_ENV all read it alike.
#
# Files that cannot read it keep a copy: the Dockerfiles (they must build on
# their own, with plain `docker build`, compose and bake alike), go.mod,
# Cargo.toml, package.json, the README's commands and the compose and stack
# files (Portainer deploys them as they are). scripts/check-versions.sh
# fails when any copy differs from this file, and CI runs it: bump a version
# here, then run the check to find the copies to change with it.

# Go: golang image (scripts/go.sh, backend/Dockerfile), backend/go.mod.
GO_VERSION=1.26.10
# Go linters, installed into the cached GOBIN (tests.yml, README).
GOLANGCI_LINT_VERSION=v2.15.0
GOVULNCHECK_VERSION=v1.9.0

# Rust: rust image (scripts/wasm.sh, web/Dockerfile).
RUST_VERSION=1.99.1
# wasm-bindgen-cli must equal the wasm-bindgen crate (frontend/engine/Cargo.toml).
WASM_BINDGEN_VERSION=0.2.130
CARGO_DENY_VERSION=0.20.2
# Binaryen's wasm-opt: release tag and the checksum of its x86_64 Linux tarball.
BINARYEN_VERSION=version_133
BINARYEN_SHA256=2dc9c7813f5375db93d96ead4b78222fcc3e2677bbb832297af4797782a37489

# Node: node image (scripts/node.sh, scripts/regions.sh, web/Dockerfile).
NODE_VERSION=22.21.1
# The Playwright image the end-to-end tests run in (tests.yml, README) must
# match @playwright/test in frontend/package.json.
PLAYWRIGHT_VERSION=1.64.1

# Images the stack runs, pinned to a patch release: scripts/integration.sh and
# scripts/bench.sh read these; compose.yaml, deploy/compose.production.yaml
# and deploy/stack.swarm.yaml keep copies. Postgres stays on major 16: a new
# major needs a data migration (pg_upgrade or dump and restore).
POSTGRES_IMAGE=postgres:16.15-alpine
REDIS_IMAGE=redis:7.4.12-alpine
MOSQUITTO_IMAGE=eclipse-mosquitto:2.1.2-alpine
# The public web image's runtime (web/Dockerfile), by digest as well.
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
