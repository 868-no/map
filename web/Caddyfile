{
	admin off
	servers {
		# Honour X-Forwarded-For only from private-range proxies (e.g. an
		# upstream TLS terminator); otherwise the direct peer is the client.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# Every worker (MapLibre's and the mesh engine's) is a script of this origin, so
		# worker-src allows 'self' alone. 'wasm-unsafe-eval' allows compiling
		# the mesh engine (WebAssembly) and nothing else: JavaScript eval stays blocked.
		# CSP_CONNECT_EXTRA (empty by default) adds sources to connect-src, e.g. the
		# host of an online TileJSON basemap (MAP_TILE_SOURCE; see docs/basemap.md).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' {$CSP_CONNECT_EXTRA:}; font-src 'self'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	# Optional access control: mount files at /etc/caddy/auth/*.caddy
	# (see docs/operations.md). Nothing is imported when none exist.
	import /etc/caddy/auth/*.caddy

	# Upstreams (D-157). One `meshmap serve` answers everything by default.
	# A split deployment (deploy/stack.swarm.yaml) sets API_UPSTREAM to the
	# `serve --no-ingest` replicas and FETCH_UPSTREAM to the single ingesting
	# process, which alone fetches weather and terrain upstream and alone
	# knows the brokers' state: those routes, the capabilities that report
	# them, and health go there.
	handle /api/* {
		@fetch path /api/v1/weather /api/v1/terrain /api/v1/terrain/* /api/v1/capabilities
		handle @fetch {
			reverse_proxy {$FETCH_UPSTREAM:backend:8000}
		}
		handle {
			reverse_proxy {$API_UPSTREAM:backend:8000} {
				flush_interval -1 # SSE
			}
		}
	}
	handle /health/* {
		reverse_proxy {$FETCH_UPSTREAM:backend:8000}
	}
	# Tiles: cached by the browser's HTTP cache (range requests, ETag), never
	# by the service worker. A rebuilt basemap changes the ETag.
	handle /tiles/* {
		root * /srv
		header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		file_server
	}
	handle /fonts/* {
		root * /srv
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}
	handle /styles/* {
		root * /srv
		header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
		file_server
	}
	# The commit this image was built from (empty for local builds): CI's
	# deploy job polls it until production serves the new images.
	handle /version.txt {
		root * /srv/version
		header Cache-Control "no-store"
		file_server
	}
	# Content-hashed build output: cache forever. Its own block with no
	# fallback, so a file from an older deploy is a 404, never the app's HTML
	# stored under an asset URL for a year. Only files that exist are
	# immutable: during a rolling deploy an old replica answers a new page's
	# asset with 404, which Cloudflare and browsers would otherwise keep for
	# a year under that URL (it happened: an unstyled map until the CSS hash
	# changed). A miss is no-store, so the next request reaches a new replica.
	handle /assets/* {
		root * /srv/app
		@built file
		header @built Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}
	handle {
		root * /srv/app
		@icons path /icons/* /favicon.svg
		header @icons Cache-Control "public, max-age=604800"
		# Entry points must revalidate so a new deploy is picked up: the pages,
		# the service worker (which carries the precache list), the manifest and
		# the unhashed scripts next to the pages.
		@entry path / /index.html /sw.js /manifest.webmanifest /theme-boot.js /privacy.html /privacy.js /api-docs.html /api-docs.js
		header @entry Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}
}
